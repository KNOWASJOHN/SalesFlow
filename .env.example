# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# never commit it. The app loads it via pydantic-settings.

# ---- Database ----
# Driver is psycopg (v3), hence the `+psycopg` suffix.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME

# ---- WebRTC signaling (WS /ws/signaling) ----
# Shared HS256 secret used to verify the `access_token` query parameter on the
# WebSocket handshake. Must be at least 32 bytes for SHA256 — shorter keys
# produce an InsecureKeyLengthWarning from PyJWT.
# Use a different value per environment; it is the only thing protecting the
# signaling socket.
SIGNALING_JWT_SECRET=replace-with-at-least-32-random-bytes

# JWT algorithm and audience. Only change these if you also change how the
# employee web client and Flutter client mint their tokens.
SIGNALING_JWT_ALGORITHM=HS256
SIGNALING_JWT_AUDIENCE=sales-signaling

# Note: if SIGNALING_JWT_SECRET is absent the app still boots, but the
# signaling endpoint fails closed — every socket is refused with AUTH_FAILED.
# See docs/signaling-contract.md for the token claims clients must send.
